<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rendering: Bevy's wgpu prefers Vulkan and falls back to GLES 3.2. -->
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />
    <!-- Input: a controller OR mouse & keyboard is required at runtime, but
         neither is a hardware feature Play can filter on; there are no touch
         controls, so a touchscreen is not required either. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:hasCode="true"
        android:theme="@style/Theme.SegnaleDebole">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale|touchscreen|colorMode"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:theme="@style/Theme.SegnaleDebole">
            <!-- GameActivity loads lib<lib_name>.so and calls its android_main
                 (generated by Bevy's #[bevy_main]). -->
            <meta-data android:name="android.app.lib_name" android:value="segnale_debole" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
